# Local development only. Run `make init-local` to generate private secrets in .env.
APP_ENV=development
POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16-alpine
REDIS_IMAGE=mirror.gcr.io/library/redis:7-alpine
MINIO_IMAGE=bitnamilegacy/minio:latest
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://icms:CHANGE_ME@localhost:5432/icms
POSTGRES_DB=icms
POSTGRES_USER=icms
POSTGRES_PASSWORD=CHANGE_ME
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=icms-local
MINIO_SECRET_KEY=CHANGE_ME
MINIO_ROOT_USER=icms-local
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=icms-evidence
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAIL=admin@icms.dev
ADMIN_PASSWORD=CHANGE_ME
AI_ENCRYPTION_KEY=CHANGE_ME_GENERATED_BY_INIT_LOCAL
BILLING_ENABLED=false
ALIPAY_RECEIVER_ACCOUNT=
